{
  "name": "@mailchannels/directus-extension-mailchannels",
  "version": "0.1.0",
  "description": "Send Directus email reliably through MailChannels: delivery tracking, bounce handling and domain authentication built in. Free to start.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "directus-extension",
    "directus",
    "mailchannels",
    "email",
    "flows"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "icon": "outgoing_mail",
  "scripts": {
    "build": "directus-extension build",
    "test": "node --test test/*.test.mjs",
    "validate": "directus-extension validate"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "18.1.0"
  },
  "directus:extension": {
    "type": "operation",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "source": {
      "app": "src/app.js",
      "api": "src/api.js"
    },
    "host": "^12.4.1",
    "sandbox": {
      "enabled": true,
      "requestedScopes": {
        "request": {
          "methods": [
            "POST"
          ],
          "urls": [
            "https://api.mailchannels.net/tx/v1/send",
            "https://api.mailchannels.net/tx/v1/send?dry-run=true"
          ]
        }
      }
    }
  },
  "bugs": {
    "email": "dev@mailchannels.com",
    "url": "https://github.com/mailchannels/directus-extension-mailchannels/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mailchannels/directus-extension-mailchannels.git"
  },
  "homepage": "https://github.com/mailchannels/directus-extension-mailchannels#readme",
  "overrides": {
    "deepmerge": "4.1.2",
    "joi": "18.3.2"
  }
}
